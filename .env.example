# OpenRouter explanation service
VITE_OPENROUTER_API_KEY=sk-or-v1-your-key-here
VITE_OPENROUTER_MODEL=openrouter/auto
VITE_OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
VITE_OPENROUTER_TITLE=Cat Breed Classifier

# ONNX Runtime
VITE_ONNX_WASM_PATHS=/
VITE_ONNX_LOG_LEVEL=fatal

# Image preprocessing and inference
VITE_PREPROCESS_MEAN=113.84185,107.20119,100.25863
VITE_DEFAULT_INPUT_SIZE=224
VITE_SUPPORTED_IMAGE_SIZES=224,227
VITE_INFERENCE_TOP_K=5

# Assets
VITE_CLASS_LABELS_URL=/classes/classNames-cat.json

# Occlusion analysis
VITE_OCCLUSION_GRID_SIZE=7
VITE_OCCLUSION_CLAMP_NEGATIVE=true

# Heatmap visualization
VITE_HEATMAP_DEFAULT_OPACITY=0.5
VITE_HEATMAP_MIN_OPACITY=0.2
VITE_HEATMAP_MAX_OPACITY=0.8
VITE_HEATMAP_OPACITY_STEP=0.05
VITE_HEATMAP_BASE_ALPHA=0.15
VITE_HEATMAP_ALPHA_RANGE=0.85
VITE_HEATMAP_HUE_START=240
VITE_HEATMAP_HUE_END=0
VITE_HEATMAP_SATURATION=90
VITE_HEATMAP_LIGHTNESS=55
VITE_HEATMAP_IMAGE_QUALITY=0.85

# Built-in models
VITE_MODEL_GOOGLENET_NAME=GoogleNet
VITE_MODEL_GOOGLENET_LABEL=GoogLeNet
VITE_MODEL_GOOGLENET_URL=/models/cat-10breeds-net-google.onnx
VITE_MODEL_GOOGLENET_INPUT_SIZE=224
VITE_MODEL_SQUEEZENET_NAME=SqueezeNet
VITE_MODEL_SQUEEZENET_LABEL=SqueezeNet
VITE_MODEL_SQUEEZENET_URL=/models/cat-10breeds-net-squeezenet.onnx
VITE_MODEL_SQUEEZENET_INPUT_SIZE=227
VITE_MODEL_RESNET18_NAME=ResNet-18
VITE_MODEL_RESNET18_LABEL=ResNet-18
VITE_MODEL_RESNET18_URL=/models/cat-10breeds-net-resnet18.onnx
VITE_MODEL_RESNET18_INPUT_SIZE=224
VITE_MODEL_RESNET50_NAME=ResNet-50
VITE_MODEL_RESNET50_LABEL=ResNet-50
VITE_MODEL_RESNET50_URL=/models/cat-10breeds-net-resnet50.onnx
VITE_MODEL_RESNET50_INPUT_SIZE=224
